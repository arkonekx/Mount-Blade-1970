; Ustawienia projektu "Zimna Wojna 1975" (Godot 4.7).
config_version=5

[application]

config/name="Zimna Wojna 1975"
config/description="Kampania USA vs ZSRR w 1975 roku: mapa 2D z mgłą wojny i bitwy FPS w 3D."
