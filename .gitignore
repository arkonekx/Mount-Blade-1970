# Godot 4+ — pamięć podręczna edytora (generowana lokalnie)
.godot/

# Ustawienia eksportu (zależą od maszyny)
export.cfg
export_presets.cfg

# Tłumaczenia generowane z plików CSV
*.translation

# System
.DS_Store
Thumbs.db

# Surowe obrazy AI (~21 MB) — odtwarzalne z promptów w assets/textures/terrain/README.md
tools/art/raw/

# Cache Pythona
__pycache__/
*.pyc

# Rozpakowana binarka Godota (w repo trzymamy tylko .gz)
tools/godot/bin/Godot_v*
!tools/godot/bin/*.gz
